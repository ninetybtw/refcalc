{
  "name": "referee-pay",
  "version": "1.0.0",
  "description": "Судейский кошелёк — учёт игр и заработка хоккейного судьи",
  "scripts": {
    "db:local": "wrangler d1 execute referee-pay --local --file=schema.sql",
    "db:remote": "wrangler d1 execute referee-pay --remote --file=schema.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node --no-warnings server-node.js"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  }
}
